---
/**
 * ArchStack — the "architecture at a glance" diagram for the vision page.
 * A hand-authored SVG (kept in an .astro component, not MDX, so raw SVG with
 * hyphenated attributes passes through untouched). Colors use inline styles
 * with the shared theme's CSS vars so it tracks light/dark. `seq-step` groups
 * give the step-reveal cascade when wrapped in <Figure>.
 */
---

<svg
  viewBox="0 0 760 470"
  role="img"
  aria-label="Calimero node architecture: clients talk to a node that runs a WASM app over CRDT storage, a causal DAG, and libp2p sync to peers."
  style="font-family:'DM Sans',system-ui,sans-serif;max-width:100%;height:auto"
>
  <!-- Clients -->
  <g class="seq-step" style="--step-i:0">
    <rect x="20" y="40" width="150" height="90" rx="8" style="fill:var(--sl-color-gray-7);stroke:var(--sl-color-gray-5);stroke-width:1.5" />
    <text x="95" y="72" text-anchor="middle" style="fill:var(--sl-color-white);font-size:15px;font-weight:600">Clients</text>
    <text x="95" y="94" text-anchor="middle" style="fill:var(--sl-color-gray-2);font-size:12px">mero.js · Python</text>
    <text x="95" y="112" text-anchor="middle" style="fill:var(--sl-color-gray-2);font-size:12px">Kotlin · Swift</text>
  </g>

  <!-- Node container -->
  <g class="seq-step" style="--step-i:1">
    <rect x="230" y="20" width="330" height="430" rx="10" style="fill:none;stroke:var(--sl-color-gray-6);stroke-width:1.5" stroke-dasharray="4 4" />
    <text x="395" y="42" text-anchor="middle" style="fill:var(--sl-color-gray-2);font-size:12px">Node — merod</text>
  </g>

  <!-- API surface -->
  <g class="seq-step" style="--step-i:2">
    <rect x="255" y="58" width="280" height="60" rx="8" style="fill:var(--sl-color-gray-7);stroke:var(--sl-color-gray-5);stroke-width:1.5" />
    <text x="395" y="84" text-anchor="middle" style="fill:var(--sl-color-white);font-size:15px;font-weight:600">API surface</text>
    <text x="395" y="104" text-anchor="middle" style="fill:var(--sl-color-gray-2);font-size:12px">JSON-RPC · WebSocket · SSE · admin</text>
  </g>

  <!-- WASM app -->
  <g class="seq-step" style="--step-i:3">
    <rect x="255" y="133" width="280" height="60" rx="8" style="fill:var(--sl-color-accent-low);stroke:var(--sl-color-accent);stroke-width:1.5" />
    <text x="395" y="159" text-anchor="middle" style="fill:var(--sl-color-white);font-size:15px;font-weight:600">WASM application</text>
    <text x="395" y="179" text-anchor="middle" style="fill:var(--sl-color-gray-2);font-size:12px">your logic — sandboxed, deterministic</text>
  </g>

  <!-- CRDT storage -->
  <g class="seq-step" style="--step-i:4">
    <rect x="255" y="208" width="280" height="60" rx="8" style="fill:var(--sl-color-gray-7);stroke:var(--sl-color-gray-5);stroke-width:1.5" />
    <text x="395" y="234" text-anchor="middle" style="fill:var(--sl-color-white);font-size:15px;font-weight:600">CRDT storage</text>
    <text x="395" y="254" text-anchor="middle" style="fill:var(--sl-color-gray-2);font-size:12px">collections that merge automatically</text>
  </g>

  <!-- Causal DAG -->
  <g class="seq-step" style="--step-i:5">
    <rect x="255" y="283" width="280" height="60" rx="8" style="fill:var(--sl-color-gray-7);stroke:var(--sl-color-gray-5);stroke-width:1.5" />
    <text x="395" y="309" text-anchor="middle" style="fill:var(--sl-color-white);font-size:15px;font-weight:600">Causal DAG</text>
    <text x="395" y="329" text-anchor="middle" style="fill:var(--sl-color-gray-2);font-size:12px">signed operations, causal ordering</text>
  </g>

  <!-- Network -->
  <g class="seq-step" style="--step-i:6">
    <rect x="255" y="358" width="280" height="60" rx="8" style="fill:var(--sl-color-gray-7);stroke:var(--sl-color-gray-5);stroke-width:1.5" />
    <text x="395" y="384" text-anchor="middle" style="fill:var(--sl-color-white);font-size:15px;font-weight:600">Network — libp2p</text>
    <text x="395" y="404" text-anchor="middle" style="fill:var(--sl-color-gray-2);font-size:12px">gossip broadcast + catch-up sync</text>
  </g>

  <!-- Peers -->
  <g class="seq-step" style="--step-i:7">
    <rect x="620" y="330" width="120" height="90" rx="8" style="fill:var(--sl-color-gray-7);stroke:var(--sl-color-gray-5);stroke-width:1.5" />
    <text x="680" y="368" text-anchor="middle" style="fill:var(--sl-color-white);font-size:15px;font-weight:600">Peers</text>
    <text x="680" y="390" text-anchor="middle" style="fill:var(--sl-color-gray-2);font-size:12px">other members</text>
  </g>

  <!-- Edges -->
  <g class="seq-step" style="--step-i:8">
    <line x1="170" y1="85" x2="255" y2="88" style="stroke:var(--sl-color-gray-4);stroke-width:1.5" />
    <line x1="535" y1="388" x2="620" y2="375" style="stroke:var(--sl-color-gray-4);stroke-width:1.5" />
  </g>
</svg>
