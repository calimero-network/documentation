---
/**
 * A numbered flow: boxes joined by arrows, left to right on wide screens and
 * top to bottom on narrow ones. Drawn in the landing's tokens, so it follows
 * the theme.
 *
 *   <Flow caption="..." steps={[{ k: 'Build', title: 'cargo mero build', text: '...' }, ...]} />
 */
interface Step {
	k?: string;
	title: string;
	text?: string;
	accent?: boolean;
}
interface Props {
	steps: Step[];
	caption?: string;
}
const { steps, caption } = Astro.props;
---

<figure class="cal-flow not-content">
	<ol style={`--n: ${steps.length}`}>
		{
			steps.map((s, i) => (
				<li class={s.accent ? 'accent' : undefined}>
					<span class="k">
						{String(i + 1).padStart(2, '0')}
						{s.k ? ` · ${s.k}` : ''}
					</span>
					<strong>{s.title}</strong>
					{s.text ? <span class="t">{s.text}</span> : null}
				</li>
			))
		}
	</ol>
	{caption ? <figcaption>{caption}</figcaption> : null}
</figure>

<style>
	.cal-flow {
		margin: 1.75rem 0;
	}
	ol {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(var(--n), minmax(0, 1fr));
		gap: 28px;
	}
	li {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 6px;
		padding: 14px 14px 16px;
		background: var(--cal-card);
		border: 1px solid var(--cal-box-line);
		min-width: 0;
	}
	li.accent {
		border-color: var(--cal-seal);
		box-shadow: 4px 4px 0 var(--cal-seal-soft);
	}
	li + li::before {
		content: '→';
		position: absolute;
		left: -22px;
		top: 50%;
		transform: translateY(-50%);
		font: 600 16px/1 var(--sl-font-mono);
		color: var(--cal-seal);
	}
	.k {
		font: 600 0.68rem/1.3 var(--sl-font-mono);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--cal-seal);
	}
	strong {
		font-size: 0.98rem;
		line-height: 1.25;
		color: var(--cal-ink);
		overflow-wrap: break-word;
	}
	.t {
		font-size: 0.86rem;
		line-height: 1.45;
		color: var(--cal-ink-2);
	}
	figcaption {
		margin-top: 10px;
		font: 400 0.8rem/1.5 var(--sl-font-mono);
		color: var(--cal-muted);
	}
	@media (max-width: 50rem) {
		ol {
			grid-template-columns: minmax(0, 1fr);
			gap: 24px;
		}
		li + li::before {
			content: '↓';
			left: 18px;
			top: -20px;
			transform: none;
		}
	}
</style>
