---
/**
 * Why Calimero: what running a customer-facing app yourself asks of you,
 * against one signed bundle on Calimero. The wording is the landing's
 * (calimero.network, "02 · The problem" and "03 · Why Calimero").
 */
const chores = [
	'Ship and support an on-prem edition',
	'Patch the OS and dependencies',
	'Manage secrets',
	'Configure backups',
	'Staff on-call',
	'Sit through long security reviews',
];
const answers = [
	['Sandbox', 'Apps run as sandboxed WebAssembly and only reach their own state through the node.'],
	['Security', 'Read-only images with no SSH. Keys are released only to nodes that prove their image.'],
	['Maintenance', 'Signed, versioned bundles. On Calimero Cloud, Calimero runs the nodes and their upgrades.'],
	['Privacy', 'Nobody, including Calimero, can read data inside a sealed node. Storage is encrypted at rest.'],
	['Serverless', 'Install a bundle, not a server.'],
];
---

<figure class="cal-why not-content">
	<div class="grid">
		<section class="side before">
			<header>
				<span class="k">Self-hosting</span>
				<span class="n">7 chores</span>
			</header>
			<div class="stack" aria-hidden="true">
				<span>your servers</span>
				<span>your database</span>
				<span>your keys</span>
			</div>
			<ul class="chores">
				{chores.map((c) => <li>{c}</li>)}
				<li class="bad">Admins and vendors can still see the data</li>
			</ul>
			<p class="trust">Your customers have to trust whoever runs the box.</p>
		</section>
		<div class="arrow" aria-hidden="true">→</div>
		<section class="side after">
			<header>
				<span class="k">Calimero</span>
				<span class="n">1 bundle</span>
			</header>
			<div class="bundle">
				<code>my-app.mpk</code>
				<span>frontend and app logic, signed</span>
			</div>
			<ul class="answers">
				{
					answers.map(([k, v]) => (
						<li>
							<b>{k}</b>
							<span>{v}</span>
						</li>
					))
				}
			</ul>
			<p class="trust">Your customers check the node's proof themselves.</p>
		</section>
	</div>
	<figcaption>
		Today, control means hosting. With Calimero you ship one signed bundle, and every sealed node proves which image it runs
		before it gets any keys.
	</figcaption>
</figure>

<style>
	.cal-why {
		margin: 1.75rem 0;
	}
	.grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		gap: 14px;
		align-items: stretch;
	}
	.side {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 16px;
		border: 1px solid var(--cal-rule);
		background: var(--cal-paper-2);
		min-width: 0;
	}
	.side.after {
		border-color: var(--cal-ink);
		background: var(--cal-card);
		box-shadow: 4px 4px 0 var(--cal-hard);
	}
	header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 8px;
	}
	.k {
		font: 600 0.72rem/1.4 var(--sl-font-mono);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--cal-muted);
	}
	.after .k {
		color: var(--cal-seal);
	}
	.n {
		font: 800 1.35rem/1 var(--sl-font);
		letter-spacing: -0.03em;
		color: var(--cal-ink);
	}
	.stack {
		display: grid;
		gap: 4px;
	}
	.stack span {
		padding: 6px 10px;
		border: 1px dashed var(--cal-box-line);
		font: 500 0.75rem/1.2 var(--sl-font-mono);
		color: var(--cal-ink-2);
	}
	.bundle {
		display: grid;
		gap: 2px;
		padding: 10px 12px;
		border: 1px solid var(--cal-seal);
		background: var(--cal-seal-soft);
	}
	.bundle code {
		font: 600 0.88rem/1.3 var(--sl-font-mono);
		color: var(--cal-ink);
		background: none;
		padding: 0;
	}
	.bundle span {
		font-size: 0.8rem;
		color: var(--cal-ink-2);
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 6px;
	}
	.chores li {
		font-size: 0.86rem;
		color: var(--cal-ink-2);
		padding-left: 16px;
		position: relative;
	}
	.chores li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.55em;
		width: 8px;
		height: 1px;
		background: var(--cal-muted);
	}
	.chores li.bad {
		color: var(--cal-seal);
		font-weight: 600;
	}
	.chores li.bad::before {
		background: var(--cal-seal);
	}
	.answers li {
		display: grid;
		gap: 1px;
	}
	.answers b {
		font: 600 0.7rem/1.4 var(--sl-font-mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--cal-ink);
	}
	.answers span {
		font-size: 0.86rem;
		line-height: 1.4;
		color: var(--cal-ink-2);
	}
	.trust {
		margin: auto 0 0;
		padding-top: 10px;
		border-top: 1px solid var(--cal-rule);
		font: 500 0.78rem/1.45 var(--sl-font-mono);
		color: var(--cal-muted);
	}
	.after .trust {
		color: var(--cal-ink);
	}
	.arrow {
		align-self: center;
		font: 600 1.4rem/1 var(--sl-font-mono);
		color: var(--cal-seal);
	}
	figcaption {
		margin-top: 10px;
		font: 400 0.8rem/1.5 var(--sl-font-mono);
		color: var(--cal-muted);
	}
	@media (max-width: 44rem) {
		.grid {
			grid-template-columns: minmax(0, 1fr);
		}
		.arrow {
			justify-self: center;
			transform: rotate(90deg);
		}
	}
</style>
